{
  "manifest_version": 3,
  "name": "DSH 侧边栏",
  "version": "1.0.0",
  "description": "把 dsh（127.0.0.1:3080）固定到浏览器侧边栏：可读取当前页面内容，选中文本即可引用给 dsh。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "cookies",
    "declarativeNetRequest",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 / 关闭 DSH 侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:3080/*",
        "http://localhost:3080/*",
        "http://127.0.0.1:3081/*",
        "http://localhost:3081/*"
      ],
      "js": [
        "dsh-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}